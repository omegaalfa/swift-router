{
  "name": "omegaalfa/swiftrouter",
  "type": "library",
  "license": "MIT",
  "description": "High-performance PHP 8.4+ HTTP router based on a Trie, with PSR-7 and PSR-15 middleware support and worker-friendly routing.",
  "keywords": [
    "router",
    "routing",
    "http-router",
    "high-performance",
    "trie",
    "tree-router",
    "php",
    "php8",
    "psr-7",
    "psr-15",
    "middleware",
    "frankenphp",
    "worker"
  ],
  "authors": [
    {
      "name": "wrt",
      "email": "webdesenvolver.agenda@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.4",
    "laminas/laminas-diactoros": "^2.17 || ^3.0",
    "psr/http-message": "^1.1 || ^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0 || ^12.0",
    "phpstan/phpstan": "^1.11 || ^2.0",
    "infection/infection": "^0.35"
  },
  "autoload": {
    "psr-4": {
      "Omegaalfa\\SwiftRouter\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Omegaalfa\\SwiftRouter\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --no-coverage",
    "test:coverage": "phpunit --coverage-text",
    "phpstan": "phpstan analyse src --level=6",
    "analyse": "@phpstan",
    "infection": "infection --threads=max",
    "docker:config": "docker compose config",
    "docker:test": "docker compose run --rm php84-cli vendor/bin/phpunit --no-coverage",
    "docker:phpstan": "docker compose run --rm php84-cli vendor/bin/phpstan analyse src --level=6",
    "benchmark": "php benchmarks/competitors/benchmark.php",
    "serve": "php -S localhost:9000 index.php"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "infection/extension-installer": true
    }
  },
  "prefer-stable": true
}
